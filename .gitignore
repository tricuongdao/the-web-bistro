# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ── Build output (regenerated by `npm run build`) ───────────────────────────
dist/
dist-ssr/
.next/
out/
build/

# ── Logs & temp files (incl. dev-server.log, vr.log) ────────────────────────
logs/
dev tooling/shots/
*.log
*.tmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment & secrets (never commit credentials) ───────────────────────
.env
.env.*
!.env.example

# ── Local-only state ────────────────────────────────────────────────────────
*.local

# ── Glyph pipeline source font (regenerated, see dev tooling/gen-glyphs.mjs) ─
gen/

# ── Editor directories and files ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
